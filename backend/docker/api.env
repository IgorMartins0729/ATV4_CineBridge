# cinebridge-api. Credenciais de DESENVOLVIMENTO: em produção, troque e injete por secrets.
PORT=3000
LOG_LEVEL=info
# Host = nome do container do RabbitMQ; o Docker resolve pela rede cinebridge-net.
RABBITMQ_URL=amqp://guest:guest@cinebridge-mq:5672
# Dentro da rede Docker o PostgreSQL escuta na 5432; a 5434 do diagrama é a porta publicada no host.
DATABASE_URL=postgresql://cinebridge:cinebridge@recomendacoes-db:5432/recomendacoes?schema=public
# Espera por resposta via fila (RPC) e limite do provedor de profissionais (resiliência da ATV I).
RPC_TIMEOUT_MS=4000
TIMEOUT_REPOSITORIO_MS=5000
