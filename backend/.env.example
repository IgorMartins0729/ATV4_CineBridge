# Copie para .env e ajuste. O .env não vai para o git.

# Este arquivo é para rodar a API fora do Docker (npm run dev). Nos containers, cada serviço usa o
# seu arquivo em docker/<servico>.env, carregado pelo docker-compose.yml da raiz.

# --- Modo de execução ---
# Sem RABBITMQ_URL: monolito em memória, como na ATV III (não precisa de banco nem de broker).
# Com RABBITMQ_URL: modo microsserviço (ATV IV); precisa do DATABASE_URL do recomendacoes-db.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# DATABASE_URL="postgresql://cinebridge:cinebridge@localhost:5434/recomendacoes?schema=public"
# RPC_TIMEOUT_MS=4000
# Quantos profissionais fictícios gerar no modo memória
PROFISSIONAIS_MEMORIA=10000

# --- Servidor ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Processos em paralelo (use mais de 1 só no modo microsserviço)
WORKERS=1

# --- Parâmetros do algoritmo (opcionais) ---
# ESTRATEGIA_PADRAO=similaridade-cosseno
# LIMITE_ORCAMENTO_REDUZIDO=50000
# QUANTIDADE_SUGESTOES=3
# TIMEOUT_REPOSITORIO_MS=1000
# PARAMETROS_JSON={"estrategias":{"cosseno":{"pesoMagnitude":0.3}}}

# --- ATV III: Decorator (camadas em volta do recomendador, da mais interna para a mais externa; vazio = nenhuma) ---
# DECORADORES=cache,auditoria,compressao
# PARAMETROS_JSON={"decoradores":{"porProdutor":{"prod-1":["auditoria"]},"cache":{"ttlMs":60000,"capacidade":500}}}

# --- ATV III: Adapter (provedor de cada serviço externo; todos simulados em memória, exceto "local") ---
# ARMAZENAMENTO=s3            # s3 | google-cloud | local
# DIRETORIO_ARQUIVOS=arquivos # pasta usada por ARMAZENAMENTO=local
# PAGAMENTO=stripe            # stripe | pagseguro | paypal
# FONTE_PROFISSIONAIS=interno # interno | linkedin | indeed
